 # growth 域常量（travel.go / report.go 与本次实测对齐）
 PATH_LIST_TASKS     = "/v2/activity/growth/tasks"
+
+# 瞬时网络错误重试（连接重置 / 读超时 / DNS 抖动）。
+# 为什么需要：_request 对非 HTTPError 的异常返回 -1，而 list_tasks 见到非 200
+# 直接 raise。一次瞬时抖动就会让**整批账号**在回读阶段崩掉（实测：第 2 个账号
+# 崩后，剩余 6 个账号完全没跑）。这里只对 GET 重试——GET 幂等，POST（上报/领奖）
+# 不重试，避免「服务端已处理但响应丢失」造成重复入账。
+_TRANSIENT_RETRIES   = 2
+_TRANSIENT_RETRY_GAP = 1.5
+
 PATH_ACCEPT_TASKS   = "/v2/activity/growth/tasks/accept"
